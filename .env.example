# Kopieren nach .env und Werte eintragen. Die Datei .env wird nicht eingecheckt.

# Externe Adresse der Oberfläche
MONITOR_PUBLIC_URL=http://localhost:8080
MONITOR_SECURE_COOKIES=false
MONITOR_RETENTION_DAYS=30

# Benutzer-Datenbank (MariaDB aus Plesk). Leer lassen = Benutzer in lokaler SQLite-Datei.
MONITOR_USER_DB_HOST=127.0.0.1
MONITOR_USER_DB_PORT=3306
MONITOR_USER_DB_NAME=christophlp_user
MONITOR_USER_DB_USER=christophlp_user
MONITOR_USER_DB_PASSWORD=
# Tabelle mit den Spalten id, username, password_hash (wird angelegt, falls nicht vorhanden)
MONITOR_USER_DB_TABLE=users

# Kontakt für Push-Dienste (Standard: MONITOR_PUBLIC_URL, falls https)
# MONITOR_VAPID_SUBJECT=mailto:admin@example.com
